{
  "name": "kick-api",
  "version": "0.0.0",
  "description": "A universal TypeScript package for using the Kick API",
  "homepage": "https://github.com/flyback-rs/kick-api#readme",
  "license": "MIT",
  "author": "Flyback <me@flyback.rs>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyback-rs/kick-api.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "release": "bumpp --pr",
    "prepublishOnly": "pnpm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt"
  },
  "dependencies": {
    "std-env": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "bumpp": "^12.3.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">= 22.12.0"
  }
}
